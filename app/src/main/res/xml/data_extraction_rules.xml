<?xml version="1.0" encoding="utf-8"?>
<!-- The forecast cache is cheap to rebuild: keep it out of cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="week-weather.db" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="week-weather.db" />
    </device-transfer>
</data-extraction-rules>
